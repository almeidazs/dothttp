# Version of the API to be used
API_VERSION=v1

# Secret of the webhook to validate incoming requests
WEBHOOK_SECRET=abc_dev_xxx

# AbacatePay API Key
ABACATEPAY_API_KEY=abc_dev_xxx

# Base URL to use in requests
